{
  "name": "@sagecards/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SageCards API (NestJS modular monolith)",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && node --watch dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.2.3",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.2.3",
    "@sagecards/shared-types": "workspace:*",
    "better-auth": "^1.7.2",
    "mongoose": "^9.9.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@sagecards/eslint-config": "workspace:*",
    "@sagecards/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.0.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
